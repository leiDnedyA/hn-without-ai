# Required for AI classification. Without it the app serves the unfiltered feed.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna.
# CLASSIFIER_MODEL=gpt-5.6-luna

# Optional. Maximum OpenAI request starts per minute. Defaults to 60.
# CLASSIFIER_REQUESTS_PER_MINUTE=60

# Optional. Maximum news.ycombinator.com request starts per minute. Defaults to 60.
# HN_REQUESTS_PER_MINUTE=60
