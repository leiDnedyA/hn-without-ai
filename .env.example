# Required for AI classification. Without it the app serves the unfiltered feed.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna.
# CLASSIFIER_MODEL=gpt-5.6-luna

# Optional. Maximum OpenAI request starts per minute. Defaults to 60.
# CLASSIFIER_REQUESTS_PER_MINUTE=60

# Optional. Maximum news.ycombinator.com request starts per minute. Defaults to 60.
# HN_REQUESTS_PER_MINUTE=60

# Optional, strongly recommended in production. Persists classification verdicts
# across cold starts and deploys, so each story is only ever sent to the model
# once. Without them verdicts live in process memory and every new serverless
# instance re-classifies the whole front page.
# The Upstash integration sets these two; Vercel KV sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead, and either pair works.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Redis key holding the verdict hash. Bump the version suffix after
# changing the classifier prompts to invalidate every stored verdict at once.
# VERDICT_CACHE_KEY=noai-hn:verdicts:v1
